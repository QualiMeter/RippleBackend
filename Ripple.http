@baseUrl = https://localhost:7080

# Seeded users
GET {{baseUrl}}/api/v1/users

# Projects
GET {{baseUrl}}/api/v1/projects

# OpenAPI
GET {{baseUrl}}/openapi/v1.json

### 4. Scalar
GET {{baseUrl}}/scalar

# For the rest, copy projectId/taskId from the previous responses.
# Example:
# GET {{baseUrl}}/api/v1/projects/{projectId}
# GET {{baseUrl}}/api/v1/projects/{projectId}/tasks
# GET {{baseUrl}}/api/v1/projects/{projectId}/dependencies
# POST {{baseUrl}}/api/v1/projects/{projectId}/tasks/{taskId}/shift-preview
# POST {{baseUrl}}/api/v1/projects/{projectId}/tasks/{taskId}/shift-confirm
# Content-Type: application/json
# { "confirmProjectEndDate": false }


# DELETE task
# Without successors: deletes immediately.
# With successors: first call returns 409 and lists affected tasks.
# Then repeat with ?confirm=true.
# DELETE {{baseUrl}}/api/v1/projects/{projectId}/tasks/{taskId}
# DELETE {{baseUrl}}/api/v1/projects/{projectId}/tasks/{taskId}?confirm=true

# DELETE project
# Physically deletes project and cascades employees/tasks/dependencies.
# DELETE {{baseUrl}}/api/v1/projects/{projectId}
